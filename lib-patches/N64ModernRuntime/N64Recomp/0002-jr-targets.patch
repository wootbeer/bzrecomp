+std::vector<N64Recomp::JrTargets> get_jr_targets(const toml::table* patches_data) {
+    std::vector<N64Recomp::JrTargets> ret;
+    const toml::node_view data = (*patches_data)["jr_targets"];
+    if (data.is_array()) {
+        data.as_array()->for_each([&ret](auto&& el) {
+            if constexpr (toml::is_table<decltype(el)>) {
+                const toml::table& cur = *el.as_table();
+                std::optional<std::string> func_name = cur["func"].value<std::string>();
+                std::optional<uint32_t> vram = cur["vram"].value<uint32_t>();
+                const toml::array* targets = cur["targets"].as_array();
+                if (!func_name.has_value() || !vram.has_value() || targets == nullptr) {
+                    throw toml::parse_error("jr_targets entry is missing required value(s)", el.source());
+                }
+                N64Recomp::JrTargets entry{ .func_name = func_name.value(), .vram = vram.value(), .targets = {} };
+                targets->for_each([&entry](auto&& t) {
+                    if constexpr (toml::is_integer<decltype(t)>) {
+                        entry.targets.push_back((uint32_t)*t);
+                    }
+                });
+                ret.push_back(std::move(entry));
+            }
+            else {
+                throw toml::parse_error("Invalid jr_targets entry", el.source());
+            }
+        });
+    }
+    return ret;
+}
