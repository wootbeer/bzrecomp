+    float VI::pixelAspect() const {
+        // Width over height of one framebuffer pixel on the TV, relative to a 320x240 mode's pixel
+        // (which is square on a 4:3 screen). A 320-wide mode samples one pixel every two dots of
+        // the 640-dot scanline (X scale 0x200); a 640-wide mode with one row per field line, like
+        // libultra's HAN1/HAF1 640x240 modes, has pixels half as wide as they are tall.
+        const hlslpp::uint2 size = fbSize();
+        if ((xTransform.xScale == 0) || (yTransform.yScale == 0) || (size.x == 0) || (width == 0)) {
+            return 1.0f;
+        }
+
+        const float pixelWidth = xScaleFloat() / 2.0f;
+        const float pixelHeight = yScaleFloat() * (float(size.x) / float(width));
+        const float aspect = pixelWidth / pixelHeight;
+        return ((aspect > 0.1f) && (aspect < 10.0f)) ? aspect : 1.0f;
+    }
+
     float VI::xScaleFloat() const {
         return (1024.0f / xTransform.xScale);
     }
