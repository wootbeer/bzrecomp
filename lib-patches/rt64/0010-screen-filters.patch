diff --git a/src/render/rt64_screen_filter.h b/src/render/rt64_screen_filter.h
new file mode 100644
index 0000000..48a7219
--- /dev/null
+++ b/src/render/rt64_screen_filter.h
@@ -0,0 +1,21 @@
+//
+// RT64
+//
+
+#pragma once
+
+#include <cstdint>
+
+namespace RT64 {
+    // Post-process filters for the final picture, applied by the VI pass
+    // (shaders/VideoInterfacePS.hlsl). Safe to set from any thread.
+    enum class ScreenFilter : uint32_t {
+        None = 0,
+        CRT = 1, // Timothy Lottes' CRT shader, flat (no tube curve)
+        Scanlines = 2,
+        LCD = 3, // LCD3x, a handheld LCD grid
+    };
+
+    void setScreenFilter(ScreenFilter filter);
+    ScreenFilter getScreenFilter();
+};
