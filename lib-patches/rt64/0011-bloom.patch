new file mode 100644
--- /dev/null
+++ b/src/shared/rt64_bloom.h
@@ -0,0 +1,44 @@
+//
+// RT64
+//
+
+#pragma once
+
+#include "shared/rt64_hlsl.h"
+
+#define BLOOM_MODE_EXTRACT 0
+#define BLOOM_MODE_DOWNSAMPLE 1
+#define BLOOM_MODE_BLUR_X 2
+#define BLOOM_MODE_BLUR_Y 3
+
+#ifdef HLSL_CPU
+namespace interop {
+#endif
+    struct BloomCB {
+        int2 InputSize;
+        int2 OutputSize;
+        uint Mode;
+    };
+#ifdef HLSL_CPU
+};
+#else
+// How much of a colour glows (shaders/BloomCS.hlsl, shaders/VideoInterfacePS.hlsl):
+// only the most saturated colours, with some brightness: fire, explosions,
+// energy shots and lights are 0.9 and more saturated, the ground and
+// buildings less, white and grey near 0. The glow takes the colour's hue at
+// full brightness, so a dim light still glows. The HUD's colours don't glow,
+// as it's drawn into the same picture: pure green (radar, text, weapon panel,
+// markers) and its sky blue (0, 186, 255: counters and gauges).
+float3 BloomKey(float3 c) {
+    float hi = max(c.r, max(c.g, c.b));
+    float lo = min(c.r, min(c.g, c.b));
+    float saturation = (hi - lo) / max(hi, 1e-3f);
+    float weight = smoothstep(0.84f, 0.94f, saturation) * smoothstep(0.20f, 0.50f, hi);
+    float other = max(c.r, c.b) / max(c.g, 1e-3f);
+    float green = (c.g >= hi) ? 1.0f - smoothstep(0.35f, 0.60f, other) : 0.0f;
+    float gb = c.g / max(c.b, 1e-3f);
+    float sky = (c.b >= hi) ? smoothstep(0.55f, 0.65f, gb) * (1.0f - smoothstep(0.82f, 0.92f, gb)) *
+        (1.0f - smoothstep(0.20f, 0.40f, c.r / max(c.b, 1e-3f))) : 0.0f;
+    return (c / max(hi, 1e-3f)) * weight * (1.0f - max(green, sky));
+}
+#endif
