diff --git a/src/shaders/BloomCS.hlsl b/src/shaders/BloomCS.hlsl
new file mode 100644
--- /dev/null
+++ b/src/shaders/BloomCS.hlsl
@@ -0,0 +1,91 @@
+//
+// RT64
+//
+
+#include "shared/rt64_bloom.h"
+
+#define BLOCK_SIZE 8
+
+[[vk::push_constant]] ConstantBuffer<BloomCB> gConstants : register(b0);
+Texture2D<float4> gInput : register(t1);
+RWTexture2D<float4> gOutput : register(u2);
+
+// Bloom (render/rt64_screen_filter.h): a glow around the brightest strongly
+// coloured parts of the picture (lava, neon, energy shots, fire). The N64's
+// picture has no light values past white, so what glows is picked by colour:
+// bright and saturated. White and grey (text, pale walls, sky) don't glow.
+//
+// The passes, at a fixed size whatever the resolution so the glow looks the
+// same at any scale:
+//   BLOOM_MODE_EXTRACT     the picture's glowing parts, shrunk to the first level
+//   BLOOM_MODE_DOWNSAMPLE  a level halved (2 x 2 average)
+//   BLOOM_MODE_BLUR_X / _Y a level blurred, one direction at a time
+
+int2 ClampCoord(int2 coord) {
+    return clamp(coord, int2(0, 0), gConstants.InputSize - int2(1, 1));
+}
+
+float4 LoadInput(int2 coord) {
+    return gInput.Load(int3(ClampCoord(coord), 0));
+}
+
+float3 Extract(float2 outCoord) {
+    // A grid of up to 6 x 6 samples over the input pixels this texel covers,
+    // each weighed on its own, so a bright line isn't averaged away with its
+    // dark surroundings before it's judged.
+    const float2 scale = float2(gConstants.InputSize) / float2(gConstants.OutputSize);
+    const int2 count = clamp(int2(ceil(scale)), int2(1, 1), int2(6, 6));
+    float3 sum = 0.0f;
+    for (int y = 0; y < count.y; y++) {
+        for (int x = 0; x < count.x; x++) {
+            float2 inPos = (outCoord + (float2(x, y) + 0.5f) / float2(count)) * scale;
+            sum += BloomKey(LoadInput(int2(inPos)).rgb);
+        }
+    }
+
+    return sum / float(count.x * count.y);
+}
+
+float3 Downsample(int2 outCoord) {
+    int2 inCoord = outCoord * 2;
+    return (LoadInput(inCoord).rgb + LoadInput(inCoord + int2(1, 0)).rgb +
+        LoadInput(inCoord + int2(0, 1)).rgb + LoadInput(inCoord + int2(1, 1)).rgb) * 0.25f;
+}
+
+float3 Blur(int2 outCoord, int2 direction) {
+    // Gaussian, sigma 3 texels, 13 taps.
+    const float Sigma = 3.0f;
+    float3 sum = 0.0f;
+    float weightSum = 0.0f;
+    [unroll]
+    for (int i = -6; i <= 6; i++) {
+        float weight = exp(-float(i * i) / (2.0f * Sigma * Sigma));
+        sum += LoadInput(outCoord + direction * i).rgb * weight;
+        weightSum += weight;
+    }
+
+    return sum / weightSum;
+}
+
+[numthreads(BLOCK_SIZE, BLOCK_SIZE, 1)]
+void CSMain(uint2 coord : SV_DispatchThreadID) {
+    if (any(coord >= uint2(gConstants.OutputSize))) {
+        return;
+    }
+
+    float3 color;
+    if (gConstants.Mode == BLOOM_MODE_EXTRACT) {
+        color = Extract(float2(coord));
+    }
+    else if (gConstants.Mode == BLOOM_MODE_DOWNSAMPLE) {
+        color = Downsample(int2(coord));
+    }
+    else if (gConstants.Mode == BLOOM_MODE_BLUR_X) {
+        color = Blur(int2(coord), int2(1, 0));
+    }
+    else {
+        color = Blur(int2(coord), int2(0, 1));
+    }
+
+    gOutput[coord] = float4(color, 1.0f);
+}
