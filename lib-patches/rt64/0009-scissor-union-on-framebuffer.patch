+    void FixedRect::mergeWithinWidth(const FixedRect &rect, int32_t maxX) {
+        FixedRect clipped = rect;
+        clipped.ulx = std::clamp(clipped.ulx, 0, maxX);
+        clipped.lrx = std::clamp(clipped.lrx, 0, maxX);
+        if (clipped.lrx > clipped.ulx) {
+            merge(clipped);
+        }
+        else if (isNull()) {
+            // Nothing on the framebuffer: keep the rect as it was rather than leave the merge empty.
+            merge(rect);
+        }
+    }
